{
    "name": "mammothwp/acceptance-logs",
    "description": "MammothWP Acceptance Logs: versioned, role-scoped, tamper-evident logging that your users accepted your terms.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://mammothwp.com/plugins/mammothwp-acceptance-logs/",
    "authors": [
        {
            "name": "Mammoth WP",
            "homepage": "https://mammothwp.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0",
        "mammothwp/wp-kit": "dev-main",
        "mammothwp/support": "dev-main"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mammothwp/wp-release": "dev-main",
        "mammothwp/wp-self-test": "dev-main",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MammothWP\\AcceptanceLogs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MammothWP\\AcceptanceLogs\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint:phpcs": "phpcs",
        "lint:phpstan": "phpstan analyse --memory-limit=1G",
        "test:phpunit": "phpunit",
        "lint": [
            "@lint:phpcs",
            "@lint:phpstan"
        ],
        "build": "mmwp-release build",
        "check": "mmwp-release check --strict --self-test"
    },
    "support": {
        "email": "info@mammothwp.com",
        "issues": "https://github.com/mammothwp/admin-terms-acceptance/issues",
        "source": "https://github.com/mammothwp/admin-terms-acceptance",
        "docs": "https://mammothwp.com/plugins/mammothwp-acceptance-logs/"
    }
}