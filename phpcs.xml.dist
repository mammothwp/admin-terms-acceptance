<?xml version="1.0"?>
<ruleset name="MammothWP Acceptance Logs">
	<description>WordPress coding standards and PHP 8.1+ compatibility.</description>

	<file>mammoth-acceptance-logs.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.1-"/>

	<!-- Core + Extra: formatting, security, i18n, DB, naming. WordPress-Docs (docblock
	     completeness) is a tracked follow-up. -->
	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files are named after the class, as Composer requires. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO.Mixed"/>
		<!-- WordPress hook callbacks have fixed signatures; unused trailing arguments are expected. -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mammoth-acceptance-logs"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mmwp"/>
				<element value="MammothWP"/>
			</property>
		</properties>
	</rule>

	<!-- Tests may use fixtures with short names and direct assertions. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
